#!/usr/bin/env bash
# Reject commits that attribute work to an AI agent, and (where the repo uses
# them) commit messages that don't follow Conventional Commits.
#
# Install with `scripts/install-git-hooks.sh`. Detection is shared with the
# pre-push hook and CI — see .github/scripts/agent-attribution-scan.sh.

set -uo pipefail

msg_file="$1"
repo_root="$(git rev-parse --show-toplevel)"
scan="$repo_root/.github/scripts/agent-attribution-scan.sh"

# Strip git's comment lines (those starting with '#') before inspecting.
msg_body="$(grep -v '^#' "$msg_file" || true)"

first_line="$(printf '%s\n' "$msg_body" | sed -n '1{/^$/d;p;q;}')"

# Auto-generated subjects (merge, revert, fixup!, squash!, amend!) are exempt
# from the Conventional Commits rule below — git writes them, not a human.
# They are NOT exempt from the agent-attribution check: a merge or a revert can
# carry an agent identity or an agent co-author trailer just as easily as any
# other commit, and letting those subjects skip the scan would leave a hole you
# could drive a `git revert` through. So the exemption is recorded here and
# applied only where it belongs, after the scan.
conventional_exempt=0
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *)
    conventional_exempt=1
    ;;
esac

fail() {
  printf '\ncommit-msg hook rejected this commit:\n\n  %s\n\n' "$1" >&2
  exit 1
}

# 1. No AI-agent attribution — an agent Co-authored-by trailer in the message,
#    or an agent author/committer identity for the commit being made. The
#    commit object does not exist yet, so the pending identity is passed in
#    from `git var` rather than read back off a commit.
#
#    Links to an agent session (claude.ai/code), the "🤖 Generated with …" /
#    "_Generated by [Claude Code]_" footers and ordinary prose are fine and NOT
#    matched.
if [ ! -x "$scan" ]; then
  fail "cannot find $scan — the agent-attribution detector is missing.
Restore it, or bypass this one commit with 'git commit --no-verify'."
fi

scan_text="$(mktemp)"
trap 'rm -f "$scan_text"' EXIT
printf '%s\n' "$msg_body" > "$scan_text"

scan_out="$("$scan" \
  --text-file "$scan_text" \
  --ident author    "$(git var GIT_AUTHOR_IDENT)" \
  --ident committer "$(git var GIT_COMMITTER_IDENT)" 2>&1)"
scan_status=$?
if [ "$scan_status" -eq 2 ]; then
  printf '%s\n' "$scan_out" >&2
  fail "the agent-attribution detector could not run — it fails closed rather
than letting an unscanned commit through."
fi
if [ "$scan_status" -ne 0 ]; then
  printf '\n%s\n' "$scan_out" >&2
  fail "this commit would attribute work to an AI agent. Commits are attributed
solely to the human committer.

  • remove any agent 'Co-authored-by:' line from the message, and/or
  • point your identity at yourself:
      git config user.name  '<your name>'
      git config user.email '<your email>'

(Session links and 'Generated with …' footers are fine — they don't claim
authorship. An agent co-author or an agent commit identity does.)"
fi

# 2. Reject a message release-please cannot parse.
#
#    A commit it cannot parse is DISCARDED while the run still reports success,
#    so the change never reaches the changelog — and when it is the only commit
#    since the last release, no release is proposed at all (issue #115). The
#    trigger is a body line whose first token carries a nested "(", which the
#    grammar reads as a scope. Catching it here costs a reword; catching it
#    after the merge costs a changelog entry that cannot be recovered.
parse_scan="$repo_root/.github/scripts/release-please-parse-scan.sh"
if [ ! -x "$parse_scan" ]; then
  fail "cannot find $parse_scan — the release-please parse detector is missing.
Restore it, or bypass this one commit with 'git commit --no-verify'."
fi

parse_out="$("$parse_scan" --text-file "$scan_text" 2>&1)"
parse_status=$?
if [ "$parse_status" -eq 2 ]; then
  printf '%s\n' "$parse_out" >&2
  fail "the release-please parse detector could not run — it fails closed
rather than letting an unparseable commit through."
fi
if [ "$parse_status" -ne 0 ]; then
  printf '\n%s\n' "$parse_out" >&2
  fail "release-please would silently drop this commit."
fi

# 3. Enforce Conventional Commits on the subject line.
# Format: type(scope)?!?: description   (scope optional, '!' marks breaking change)
if [ "$conventional_exempt" -eq 1 ]; then
  exit 0
fi

subject="$first_line"
if [ -z "$subject" ]; then
  fail "empty commit message."
fi

conv_re='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$conv_re"; then
  fail "subject must follow Conventional Commits, e.g. 'fix(scope): message'.
Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test.
Got: $subject"
fi

exit 0
