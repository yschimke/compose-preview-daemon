@@ -0,0 +1,14 @@
+package ee.schimke.composeai.daemon
+
+import java.lang.reflect.Field
+
+/** Class-owned metadata only: neither receiver objects nor their field values are retained. */
+internal class DeclaredFieldCache {
+  private val fields =
+    object : ClassValue<Array<Field>>() {
+      override fun computeValue(type: Class<*>): Array<Field> = type.declaredFields
+    }
+
+  /** Shared metadata array; callers must not replace its entries. */
+  fun fieldsFor(type: Class<*>): Array<Field> = fields.get(type)
+}
