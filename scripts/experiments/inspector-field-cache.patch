--- /dev/null
+++ b/data/layoutinspector/connector/src/test/kotlin/ee/schimke/composeai/daemon/DeclaredFieldCacheTest.kt
@@ -0,0 +1,63 @@
+package ee.schimke.composeai.daemon
+
+import java.lang.ref.Reference
+import java.lang.ref.WeakReference
+import org.junit.Assert.*
+import org.junit.Test
+
+class DeclaredFieldCacheTest {
+  private val cache = DeclaredFieldCache()
+
+  private open class Parent(val inherited: Int)
+
+  private class Child(var number: Int) : Parent(42)
+
+  @Test
+  fun `metadata is shared but instance state is read afresh and parents remain separate`() {
+    val fields = cache.fieldsFor(Child::class.java)
+    assertSame(fields, cache.fieldsFor(Child::class.java))
+    assertEquals(listOf("number"), fields.map { it.name })
+    assertEquals(listOf("inherited"), cache.fieldsFor(Parent::class.java).map { it.name })
+    val field = fields.single().apply { isAccessible = true }
+    val first = Child(1)
+    val second = Child(2)
+    assertEquals(1, field.get(first))
+    assertEquals(2, field.get(second))
+    first.number = 3
+    assertEquals(3, field.get(first))
+  }
+
+  private fun disposableLoader(): WeakReference<ClassLoader> {
+    val name = "ee.schimke.composeai.daemon.FieldCacheFixture"
+    val bytes =
+      javaClass.getResourceAsStream("/" + name.replace('.', '/') + ".class")!!.use {
+        it.readBytes()
+      }
+    val loader =
+      object : ClassLoader(null) {
+        override fun findClass(requested: String): Class<*> {
+          if (requested != name) throw ClassNotFoundException(requested)
+          return defineClass(name, bytes, 0, bytes.size)
+        }
+      }
+    val type = loader.loadClass(name)
+    val field = cache.fieldsFor(type).single().apply { isAccessible = true }
+    assertEquals(1, field.get(type.getDeclaredConstructor().newInstance()))
+    return WeakReference(loader)
+  }
+
+  @Test
+  fun `cached accessible fields do not retain an application loader`() {
+    val loader = disposableLoader()
+    try {
+      repeat(100) {
+        System.gc()
+        if (loader.get() == null) return
+        Thread.sleep(20)
+      }
+      assertNull("Field cache retained the application loader", loader.get())
+    } finally {
+      Reference.reachabilityFence(cache)
+    }
+  }
+}
