@@ -0,0 +1,67 @@
+package ee.schimke.composeai.renderer
+
+import java.awt.image.BufferedImage
+import java.io.File
+import javax.imageio.ImageIO
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class FixedAxesPngResizeTest {
+  @get:Rule val temporary = TemporaryFolder()
+
+  private fun image(): File =
+    temporary.newFile().also { file ->
+      val image = BufferedImage(2, 2, BufferedImage.TYPE_INT_ARGB)
+      image.setRGB(0, 0, 0xffff0000.toInt())
+      image.setRGB(1, 0, 0xff00ff00.toInt())
+      image.setRGB(0, 1, 0xff0000ff.toInt())
+      image.setRGB(1, 1, 0xffffffff.toInt())
+      ImageIO.write(image, "png", file)
+    }
+
+  @Test
+  fun `matching validated frame preserves the original PNG bytes`() {
+    val file = image()
+    val bytes = file.readBytes()
+    resizeFixedAxesPng(file, 2, 2, alreadyDecoded = true)
+    assertArrayEquals(bytes, file.readBytes())
+  }
+
+  @Test
+  fun `mismatched dimensions still resize and extend edge pixels`() {
+    for (validated in listOf(false, true)) {
+      val file = image()
+      resizeFixedAxesPng(file, 4, 3, alreadyDecoded = validated)
+      val resized = ImageIO.read(file)
+      assertEquals(4, resized.width)
+      assertEquals(3, resized.height)
+      assertEquals(0xffff0000.toInt(), resized.getRGB(0, 0))
+      assertEquals(0xff00ff00.toInt(), resized.getRGB(3, 0))
+      assertEquals(0xff0000ff.toInt(), resized.getRGB(0, 2))
+      assertEquals(0xffffffff.toInt(), resized.getRGB(3, 2))
+    }
+  }
+
+  @Test
+  fun `one fixed axis leaves the other unchanged`() {
+    val file = image()
+    resizeFixedAxesPng(file, 1, null, alreadyDecoded = true)
+    val resized = ImageIO.read(file)
+    assertEquals(1, resized.width)
+    assertEquals(2, resized.height)
+    assertEquals(0xff0000ff.toInt(), resized.getRGB(0, 1))
+  }
+
+  @Test
+  fun `failed metadata probe retains the original decode failure`() {
+    for (validated in listOf(false, true)) {
+      val file = image()
+      file.writeBytes(file.readBytes().copyOf(20))
+      assertThrows(javax.imageio.IIOException::class.java) {
+        resizeFixedAxesPng(file, 2, 2, alreadyDecoded = validated)
+      }
+    }
+  }
+}
