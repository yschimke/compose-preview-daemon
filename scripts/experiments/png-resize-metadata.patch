diff --git a/renderers/android/src/test/kotlin/ee/schimke/composeai/renderer/FixedAxesPngResizeTest.kt b/renderers/android/src/test/kotlin/ee/schimke/composeai/renderer/FixedAxesPngResizeTest.kt
