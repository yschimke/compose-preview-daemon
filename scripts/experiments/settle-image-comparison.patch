+package ee.schimke.composeai.renderer
+
+import java.awt.image.BufferedImage
+import java.awt.image.DataBufferByte
+import java.awt.image.PixelInterleavedSampleModel
+
+/** Exact getRGB-equivalent comparison with buffers owned by one settling invocation. */
+internal class FramePixelComparator {
+  private var leftStrip: IntArray? = null
+  private var rightStrip: IntArray? = null
+
+  fun samePixels(left: BufferedImage, right: BufferedImage): Boolean {
+    if (left.width != right.width || left.height != right.height) return false
+    if (left.type == right.type) {
+      val leftBytes = packedBytes(left)
+      val rightBytes = packedBytes(right)
+      if (leftBytes != null && rightBytes != null) return leftBytes.contentEquals(rightBytes)
+    }
+
+    // Indexed, premultiplied, subimage and nonstandard layouts retain getRGB color semantics.
+    val count = minOf(left.width, 4096)
+    val a = leftStrip?.takeIf { it.size >= count } ?: IntArray(count).also { leftStrip = it }
+    val b = rightStrip?.takeIf { it.size >= count } ?: IntArray(count).also { rightStrip = it }
+    for (y in 0 until left.height) {
+      var x = 0
+      while (x < left.width) {
+        val width = minOf(count, left.width - x)
+        left.getRGB(x, y, width, 1, a, 0, width)
+        right.getRGB(x, y, width, 1, b, 0, width)
+        for (i in 0 until width) if (a[i] != b[i]) return false
+        x += width
+      }
+    }
+    return true
+  }
+
+  private fun packedBytes(image: BufferedImage): ByteArray? {
+    val bands =
+      when (image.type) {
+        BufferedImage.TYPE_3BYTE_BGR -> BGR
+        BufferedImage.TYPE_4BYTE_ABGR -> ABGR
+        else -> return null
+      }
+    if (!image.colorModel.colorSpace.isCS_sRGB || image.isAlphaPremultiplied) return null
+    val raster = image.raster
+    if (raster.sampleModelTranslateX != 0 || raster.sampleModelTranslateY != 0) return null
+    val model = raster.sampleModel as? PixelInterleavedSampleModel ?: return null
+    if (
+      model.width != image.width ||
+        model.height != image.height ||
+        model.pixelStride != bands.size ||
+        model.scanlineStride.toLong() != image.width.toLong() * bands.size ||
+        !model.bandOffsets.contentEquals(bands)
+    )
+      return null
+    val buffer = raster.dataBuffer as? DataBufferByte ?: return null
+    if (buffer.numBanks != 1 || buffer.offset != 0) return null
+    val bytes = buffer.data
+    if (bytes.size.toLong() != image.width.toLong() * image.height * bands.size) return null
+    return bytes
+  }
+
+  private companion object {
+    val BGR = intArrayOf(2, 1, 0)
+    val ABGR = intArrayOf(3, 2, 1, 0)
+  }
+}
