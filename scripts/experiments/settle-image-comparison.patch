@@ -0,0 +1,90 @@
+package ee.schimke.composeai.renderer
+
+import java.awt.image.BufferedImage
+import java.awt.image.DataBufferByte
+import java.awt.image.IndexColorModel
+import java.util.Random
+import org.junit.Assert.*
+import org.junit.Test
+
+class FramePixelComparatorTest {
+  private fun reference(a: BufferedImage, b: BufferedImage): Boolean =
+    a.width == b.width &&
+      a.height == b.height &&
+      a.getRGB(0, 0, a.width, a.height, null, 0, a.width)
+        .contentEquals(b.getRGB(0, 0, b.width, b.height, null, 0, b.width))
+
+  @Test
+  fun `all standard types and subimages agree with full getRGB snapshots`() {
+    val random = Random(481)
+    val colors = IntArray(17 * 5) { random.nextInt() }
+    val images =
+      (BufferedImage.TYPE_INT_RGB..BufferedImage.TYPE_BYTE_INDEXED).flatMap { type ->
+        val image = BufferedImage(17, 5, type)
+        image.setRGB(0, 0, 17, 5, colors, 0, 17)
+        val parent = BufferedImage(31, 11, type)
+        val sub = parent.getSubimage(3, 2, 17, 5)
+        sub.setRGB(0, 0, 17, 5, colors, 0, 17)
+        listOf(image, sub)
+      }
+    val comparator = FramePixelComparator()
+    for (a in images) for (b in images) {
+      assertEquals("${a.type} vs ${b.type}", reference(a, b), comparator.samePixels(a, b))
+    }
+  }
+
+  @Test
+  fun `packed byte equality detects alpha and hidden transparent colors`() {
+    for (type in listOf(BufferedImage.TYPE_3BYTE_BGR, BufferedImage.TYPE_4BYTE_ABGR)) {
+      val a = BufferedImage(7, 3, type)
+      val b = BufferedImage(7, 3, type)
+      val comparator = FramePixelComparator()
+      assertTrue(comparator.samePixels(a, b))
+      for (color in listOf(0x00000001, 0x01000000, 0x7fabcdef, 0xfffedcba.toInt())) {
+        b.setRGB(6, 2, color)
+        assertEquals(reference(a, b), comparator.samePixels(a, b))
+        a.setRGB(6, 2, color)
+        assertTrue(comparator.samePixels(a, b))
+      }
+    }
+  }
+
+  @Test
+  fun `palette indices do not substitute for visible colors`() {
+    val red = byteArrayOf(0, -1)
+    val zero = byteArrayOf(0, 0)
+    val first = IndexColorModel(8, 2, red, zero, zero)
+    val second = IndexColorModel(8, 2, red.reversedArray(), zero, zero)
+    val a = BufferedImage(7, 3, BufferedImage.TYPE_BYTE_INDEXED, first)
+    val b = BufferedImage(7, 3, BufferedImage.TYPE_BYTE_INDEXED, second)
+    val comparator = FramePixelComparator()
+    assertFalse(comparator.samePixels(a, b))
+    (b.raster.dataBuffer as DataBufferByte).data.fill(1)
+    assertTrue(comparator.samePixels(a, b))
+  }
+
+  @Test
+  fun `strip boundaries and reused trailing buffers preserve last pixel checks`() {
+    val comparator = FramePixelComparator()
+    for (width in listOf(8193, 4097, 17, 4096, 1)) {
+      val a = BufferedImage(width, 3, BufferedImage.TYPE_INT_ARGB)
+      val b = BufferedImage(width, 3, BufferedImage.TYPE_INT_ARGB_PRE)
+      assertTrue(comparator.samePixels(a, b))
+      b.setRGB(width - 1, 2, -1)
+      assertFalse(comparator.samePixels(a, b))
+      a.setRGB(width - 1, 2, -1)
+      assertTrue(comparator.samePixels(a, b))
+    }
+  }
+
+  @Test
+  fun `equal area does not imply equal dimensions`() {
+    assertFalse(
+      FramePixelComparator()
+        .samePixels(
+          BufferedImage(4, 3, BufferedImage.TYPE_4BYTE_ABGR),
+          BufferedImage(6, 2, BufferedImage.TYPE_4BYTE_ABGR),
+        )
+    )
+  }
+}
